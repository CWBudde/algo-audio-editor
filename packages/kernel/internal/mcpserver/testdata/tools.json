[
  {
    "name": "apply_chain",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "additionalProperties": false,
          "properties": {
            "operations": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "range": {
                    "type": "string"
                  }
                },
                "required": ["method", "params"],
                "type": "object"
              },
              "type": ["null", "array"]
            },
            "version": {
              "type": "integer"
            }
          },
          "required": ["version", "operations"],
          "type": "object"
        },
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        }
      },
      "required": ["documentId", "chain"],
      "type": "object"
    }
  },
  {
    "name": "apply_effect",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "graph": {
          "additionalProperties": false,
          "properties": {
            "connections": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "fromPortIndex": {
                    "type": "integer"
                  },
                  "to": {
                    "type": "string"
                  },
                  "toPortIndex": {
                    "type": "integer"
                  }
                },
                "required": ["from", "to"],
                "type": "object"
              },
              "type": ["null", "array"]
            },
            "nodes": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "bypassed": {
                    "type": "boolean"
                  },
                  "id": {
                    "type": "string"
                  },
                  "params": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": ["id", "type", "params"],
                "type": "object"
              },
              "type": ["null", "array"]
            }
          },
          "required": ["nodes", "connections"],
          "type": "object"
        },
        "range": {
          "additionalProperties": false,
          "description": "optional range in sample frames; omit to use the current selection",
          "properties": {
            "channelMask": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "start": {
              "type": "integer"
            }
          },
          "required": ["start", "end", "channelMask"],
          "type": ["null", "object"]
        },
        "wet": {
          "type": ["null", "number"]
        }
      },
      "required": ["documentId", "graph"],
      "type": "object"
    }
  },
  {
    "name": "apply_operation",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        },
        "dryRun": {
          "description": "process/effects only; evaluates then discards the candidate",
          "type": "boolean"
        },
        "operation": {
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string"
            },
            "params": {
              "additionalProperties": true,
              "type": "object"
            },
            "range": {
              "type": "string"
            }
          },
          "required": ["method", "params"],
          "type": "object"
        }
      },
      "required": ["documentId", "operation"],
      "type": "object"
    }
  },
  {
    "name": "close_document",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        }
      },
      "required": ["documentId"],
      "type": "object"
    }
  },
  {
    "name": "detect_clipping",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        },
        "range": {
          "additionalProperties": false,
          "description": "optional range in sample frames; omit to use the current selection",
          "properties": {
            "channelMask": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "start": {
              "type": "integer"
            }
          },
          "required": ["start", "end", "channelMask"],
          "type": ["null", "object"]
        },
        "threshold": {
          "description": "linear amplitude threshold, normally 1",
          "type": "number"
        }
      },
      "required": ["documentId", "threshold"],
      "type": "object"
    }
  },
  {
    "name": "document_info",
    "inputSchema": {
      "additionalProperties": false,
