[
  {
    "name": "apply_chain",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "additionalProperties": false,
          "properties": {
            "operations": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": ["method", "params"],
                "type": "object"
              },
              "type": ["null", "array"]
            },
            "version": {
              "type": "integer"
            }
          },
          "required": ["version", "operations"],
          "type": "object"
        },
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        }
      },
      "required": ["documentId", "chain"],
      "type": "object"
    }
  },
  {
    "name": "apply_effect",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bypass": {
          "type": "boolean"
        },
        "documentId": {
          "description": "session document id returned by open_document",
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
