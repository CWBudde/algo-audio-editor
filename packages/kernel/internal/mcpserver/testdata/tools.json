          "additionalProperties": false,
          "properties": {
            "connections": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "fromPortIndex": {
                    "type": "integer"
                  },
                  "to": {
                    "type": "string"
                  },
                  "toPortIndex": {
                    "type": "integer"
                  }
                },
                "required": ["from", "to"],
                "type": "object"
              },
              "type": ["null", "array"]
            },
            "nodes": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "bypassed": {
                    "type": "boolean"
                  },
                  "id": {
                    "type": "string"
                  },
                  "params": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": ["id", "type", "params"],
                "type": "object"
              },
              "type": ["null", "array"]
            }
          },
          "required": ["nodes", "connections"],
          "type": "object"
        },
        "range": {
          "additionalProperties": false,
          "description": "optional range in sample frames; omit to use the current selection",
          "properties": {
            "channelMask": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "start": {
              "type": "integer"
            }
          },
          "required": ["start", "end", "channelMask"],
          "type": ["null", "object"]
        },
        "wet": {
          "type": ["null", "number"]
        }
      },
      "required": ["documentId", "graph"],
      "type": "object"
    }
  },
