@@ -0,0 +1,82 @@
+package pcm
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+
+	flac "github.com/tphakala/go-flac"
+	"github.com/tphakala/go-flac/internal/meta"
+)
+
+func TestDecoderOptionsMetadataAndReset(t *testing.T) {
+	stream := buildStream()
+	headerBytes := int64(len(buildStreamInfo()))
+	if _, err := NewDecoderWithOptions(bytes.NewReader(stream), DecoderOptions{MaxMetadataBytes: headerBytes - 1}); !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("got %v, want metadata limit", err)
+	}
+	d, err := NewDecoderWithOptions(bytes.NewReader(stream), DecoderOptions{MaxMetadataBytes: headerBytes})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(io.Discard, d); err != nil {
+		t.Fatal(err)
+	}
+	// Add one padding block; Reset must preserve the exact constructor ceiling.
+	larger := buildStreamInfo()
+	larger[4] &^= 0x80
+	larger = append(larger, meta.EncodeBlockHeader(true, meta.TypePadding, 0)...)
+	larger = append(larger, buildFrame()...)
+	if err := d.Reset(bytes.NewReader(larger)); !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("reset got %v, want preserved metadata limit", err)
+	}
+	if d.Info() != (flac.StreamInfo{}) {
+		t.Fatal("failed reset exposed stale stream info")
+	}
+	if err := d.Reset(bytes.NewReader(stream)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(io.Discard, d); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDecoderOptionsNegativeLimits(t *testing.T) {
+	for _, opts := range []DecoderOptions{{MaxMetadataBytes: -1}, {MaxScratchBytes: -1}} {
+		if _, err := NewDecoderWithOptions(bytes.NewReader(buildStream()), opts); !errors.Is(err, flac.ErrResourceLimit) {
+			t.Fatalf("got %v, want resource limit", err)
+		}
+	}
+}
+
+func TestDecoderSkipSeekTablePreservesSeeking(t *testing.T) {
+	stream := buildStreamInfo()
+	stream[4] &^= 0x80
+	body := meta.EncodeSeekPoints([]meta.SeekPoint{{SampleNumber: 0, ByteOffset: 0, FrameSamples: 2}})
+	stream = append(stream, meta.EncodeBlockHeader(true, meta.TypeSeekTable, len(body))...)
+	stream = append(stream, body...)
+	stream = append(stream, buildFrame()...)
+	var expected []byte
+	for _, skip := range []bool{false, true} {
+		d, err := NewDecoderWithOptions(bytes.NewReader(stream), DecoderOptions{SkipSeekTable: skip})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := len(d.seekPoints); got != map[bool]int{false: 1, true: 0}[skip] {
+			t.Fatalf("skip=%v: retained %d points", skip, got)
+		}
+		if landed, err := d.SeekToSample(1); err != nil || landed != 1 {
+			t.Fatalf("skip=%v: seek %d, %v", skip, landed, err)
+		}
+		got, err := io.ReadAll(d)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !skip {
+			expected = got
+		} else if !bytes.Equal(got, expected) {
+			t.Fatalf("skipping table changed seek PCM: %x != %x", got, expected)
+		}
+	}
+}
