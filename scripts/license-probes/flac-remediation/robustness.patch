@@ -74,0 +79,42 @@ func parseSeekTable(body []byte) ([]SeekPoint, error) {
+
+// SeekPointMemoryBytes includes the padding of the retained in-memory point.
+const SeekPointMemoryBytes = int64(unsafe.Sizeof(SeekPoint{}))
+
+// readSeekTable uses one fixed-size entry buffer. Slice growth follows entries
+// actually read, never the untrusted declared table length, and its capacity is
+// capped by the caller's retained-memory ceiling.
+func readSeekTable(br *bitio.Reader, length int, maxBytes int64) ([]SeekPoint, error) {
+	var out []SeekPoint
+	var entry [SeekPointBytes]byte
+	maxPoints := maxBytes / SeekPointMemoryBytes
+	for off := 0; off < length; off += SeekPointBytes {
+		for i := range entry {
+			b, err := br.ReadBits(8)
+			if err != nil {
+				return nil, err
+			}
+			entry[i] = byte(b)
+		}
+		sn := binary.BigEndian.Uint64(entry[:8])
+		if sn == PlaceholderSampleNumber {
+			continue
+		}
+		if int64(len(out)) >= maxPoints {
+			return nil, fmt.Errorf("meta: retained seek points exceed byte limit: %w", flac.ErrResourceLimit)
+		}
+		if len(out) == cap(out) {
+			next := cap(out) * 2
+			if next < 1 {
+				next = 1
+			}
+			if int64(next) > maxPoints {
+				next = int(maxPoints)
+			}
+			grown := make([]SeekPoint, len(out), next)
+			copy(grown, out)
+			out = grown
+		}
+		out = append(out, SeekPoint{SampleNumber: sn, ByteOffset: binary.BigEndian.Uint64(entry[8:16]), FrameSamples: binary.BigEndian.Uint16(entry[16:18])})
+	}
+	return out, nil
+}
