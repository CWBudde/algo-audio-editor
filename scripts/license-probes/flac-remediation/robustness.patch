+package pcm_test
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/tphakala/go-flac/pcm"
+)
+
+// GO_FLAC_REFERENCE_TEST=1 makes libFLAC mandatory; without it a machine that
+// lacks the independent decoder explicitly skips this opt-in interoperability
+// test. It checks decoded PCM bytes, not the candidate's own permissive decoder.
+func TestEncodeWideResidualLimitsReference(t *testing.T) {
+	if runtime.GOOS == "js" {
+		t.Skip("independent subprocess decoder is native-only")
+	}
+	flacPath, err := exec.LookPath("flac")
+	if err != nil {
+		if os.Getenv("GO_FLAC_REFERENCE_TEST") == "1" {
+			t.Fatal("required independent flac decoder missing")
+		}
+		t.Skip("independent flac decoder unavailable")
+	}
+	for _, level := range []int{0, 3, 5, 8} {
+		for channels := 1; channels <= 8; channels++ {
+			for _, samples := range []int{4095, 4096, 4097, 9000} {
+				t.Run(fmt.Sprintf("level%d/ch%d/frames%d", level, channels, samples), func(t *testing.T) {
+					input := make([]byte, samples*channels*4)
+					for i := 0; i < samples*channels; i++ {
+						var value int64
+						switch i % 7 {
+						case 0:
+							value = -1 << 31
+						case 1:
+							value = 1<<31 - 1
+						case 2:
+							value = 0
+						default:
+							value = int64(uint32(uint64(i)*1664525+1013904223)) - (1 << 31)
+						}
+						for b := 0; b < 4; b++ {
+							input[i*4+b] = byte(value >> uint(b*8))
+						}
+					}
+					dir := t.TempDir()
+					encodedPath, decodedPath := filepath.Join(dir, "encoded.flac"), filepath.Join(dir, "decoded.pcm")
+					output, err := os.Create(encodedPath)
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer output.Close()
+					encoder, err := pcm.NewEncoder(output, pcm.Config{SampleRate: 48000, BitDepth: 32, Channels: channels, TotalSamples: uint64(samples), CompressionLevel: level})
+					if err != nil {
+						t.Fatal(err)
+					}
+					if n, err := encoder.Write(input); err != nil || n != len(input) {
+						t.Fatalf("Write = %d, %v", n, err)
+					}
+					if err := encoder.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if err := output.Close(); err != nil {
+						t.Fatal(err)
+					}
+					cmd := exec.Command(flacPath, "--decode", "--silent", "--force-raw-format", "--endian=little", "--sign=signed", "--output-name="+decodedPath, encodedPath)
+					if result, err := cmd.CombinedOutput(); err != nil {
+						t.Fatalf("reference decoder: %v: %s", err, result)
+					}
+					decoded, err := os.ReadFile(decodedPath)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if !bytes.Equal(decoded, input) {
+						t.Fatalf("reference PCM mismatch: got %d bytes, want %d", len(decoded), len(input))
+					}
+				})
+			}
+		}
+	}
+}
