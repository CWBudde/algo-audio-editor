diff --git a/internal/frame/frame.go b/internal/frame/frame.go
index 6d065e8702c10c6cf2d88c5a5ece514ae040f225..5c4e9aa011a93736d2793994b068c1e18deab6fd 100644
--- a/internal/frame/frame.go
+++ b/internal/frame/frame.go
@@ -74,0 +75,61 @@ func Decode(br *bitio.Reader, si flac.StreamInfo, dst *Frame) (err error) {
+	return DecodeWithLimits(br, si, dst, Limits{})
+}
+
+// Limits optionally restricts decoded frames before any sample scratch grows.
+// MatchStreamInfo rejects changing audio properties for fixed-format PCM readers.
+// MaxScratchBytes caps retained sample/channel slice backing stores, excluding
+// Go object, allocator and transient garbage-collection overhead. Zero is unlimited.
+type Limits struct {
+	MatchStreamInfo bool
+	MaxBlockSize    int
+	MaxScratchBytes int64
+	// AdditionalScratchPerSample and RetainedAdditionalScratch reserve caller
+	// packing storage alongside the frame, before either buffer is allocated.
+	AdditionalScratchPerSample int64
+	RetainedAdditionalScratch  int64
+}
+
+// ScratchBytes conservatively accounts retained frame backing buffers, including
+// inactive channels retained after a smaller frame. Channel headers use the
+// larger 64-bit size on every target, so the bound also holds on WASM.
+func (f *Frame) ScratchBytes() int64 {
+	n := int64(cap(f.Channels)) * 24
+	for _, ch := range f.Channels[:cap(f.Channels)] {
+		n += int64(cap(ch)) * 4
+	}
+	for i := range 2 {
+		n += int64(cap(f.work32[i]))*4 + int64(cap(f.work64[i]))*8
+	}
+	return n
+}
+
+func (f *Frame) nextScratchBytes(h *header) int64 {
+	nch, bs := h.channels(), h.blockSize
+	n := int64(max(cap(f.Channels), nch)) * 24
+	if cap(f.Channels) < nch {
+		n += int64(nch*bs) * 4
+	} else {
+		for i, ch := range f.Channels[:cap(f.Channels)] {
+			sz := cap(ch)
+			if i < nch {
+				sz = max(sz, bs)
+			}
+			n += int64(sz) * 4
+		}
+	}
+	for i := range 2 {
+		sz32, sz64 := cap(f.work32[i]), cap(f.work64[i])
+		if h.channelAssignment > 7 && h.bitsPerSample < 25 {
+			sz32 = max(sz32, bs)
+		}
+		if h.bitsPerSample >= 25 && (i == 0 || h.channelAssignment > 7) {
+			sz64 = max(sz64, bs)
+		}
+		n += int64(sz32)*4 + int64(sz64)*8
+	}
+	return n
+}
+
+// DecodeWithLimits decodes a frame with header preflight before allocating sample
+// buffers. Decode remains available for callers that handle changing formats.
+func DecodeWithLimits(br *bitio.Reader, si flac.StreamInfo, dst *Frame, limits Limits) (err error) {
@@ -90,0 +152,10 @@ func Decode(br *bitio.Reader, si flac.StreamInfo, dst *Frame) (err error) {
+	if limits.MatchStreamInfo && (hdr.sampleRate != si.SampleRate || hdr.bitsPerSample != si.BitDepth || hdr.channels() != si.Channels) {
+		return fmt.Errorf("frame: changing audio properties unsupported by fixed PCM decoder: %w", flac.ErrUnsupported)
+	}
+	if limits.MaxBlockSize > 0 && hdr.blockSize > limits.MaxBlockSize {
+		return fmt.Errorf("frame: block size %d exceeds STREAMINFO maximum %d: %w", hdr.blockSize, limits.MaxBlockSize, flac.ErrUnsupported)
+	}
+	need := dst.nextScratchBytes(&hdr) + max(limits.RetainedAdditionalScratch, int64(hdr.blockSize)*limits.AdditionalScratchPerSample)
+	if limits.MaxScratchBytes > 0 && need > limits.MaxScratchBytes {
+		return fmt.Errorf("frame: sample scratch exceeds %d bytes: %w", limits.MaxScratchBytes, flac.ErrResourceLimit)
+	}
