diff --git a/pcm/decoder_options.go b/pcm/decoder_options.go
new file mode 100644
index 0000000000000000000000000000000000000000..124a67d4ef9d1d78745d8ae879c8f52c45186b06
--- /dev/null
+++ b/pcm/decoder_options.go
@@ -0,0 +1,57 @@
+package pcm
+
+import (
+	"fmt"
+	"io"
+
+	flac "github.com/tphakala/go-flac"
+	"github.com/tphakala/go-flac/internal/meta"
+)
+
+// DefaultMaxMetadataBytes includes the FLAC marker, all metadata blocks and any
+// leading ID3 tag. Large embedded pictures can require an explicitly larger cap.
+const DefaultMaxMetadataBytes int64 = meta.DefaultMaxBytes
+
+// DefaultMaxScratchBytes bounds retained decoder-owned sample/PCM/probe buffers,
+// seek-point storage and fixed read buffers. It is not a Go runtime/RSS ceiling.
+const DefaultMaxScratchBytes int64 = 32 << 20
+
+// DecoderOptions controls decoding resource ceilings. Zero values select bounded
+// defaults; negative limits are rejected. Metadata bytes include skipped bodies.
+// MaxScratchBytes caps decoder-owned buffer capacities, including retained seek
+// points and reusable frames, but excludes caller-owned input/output, object
+// headers, Go runtime/GC bookkeeping and transient allocations during growth.
+// SkipSeekTable discards seek points while preserving forward decode and the
+// existing frame-search based seeking API for seekable sources.
+type DecoderOptions struct {
+	MaxMetadataBytes int64
+	MaxScratchBytes  int64
+	SkipSeekTable    bool
+}
+
+func normalizeDecoderOptions(opts DecoderOptions) (DecoderOptions, error) {
+	if opts.MaxMetadataBytes < 0 || opts.MaxScratchBytes < 0 {
+		return DecoderOptions{}, fmt.Errorf("go-flac/pcm: negative decoder limit: %w", flac.ErrResourceLimit)
+	}
+	if opts.MaxMetadataBytes == 0 {
+		opts.MaxMetadataBytes = DefaultMaxMetadataBytes
+	}
+	if opts.MaxScratchBytes == 0 {
+		opts.MaxScratchBytes = DefaultMaxScratchBytes
+	}
+	return opts, nil
+}
+
+// NewDecoderWithOptions reads a stream under explicit metadata/scratch limits.
+// Reusing the decoder with Reset preserves these options.
+func NewDecoderWithOptions(r io.Reader, opts DecoderOptions) (*Decoder, error) {
+	opts, err := normalizeDecoderOptions(opts)
+	if err != nil {
+		return nil, err
+	}
+	d := &Decoder{options: opts}
+	if err := d.init("NewDecoderWithOptions", r); err != nil {
+		return nil, err
+	}
+	return d, nil
+}
