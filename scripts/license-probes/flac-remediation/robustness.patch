+
+// These fixtures carry independently correct header/body CRCs, so the tests
+// exercise stream structure rather than getting rejected at the checksum gate.
+func validationFrame(block, number int, variable bool) []byte {
+	hdr := []byte{0xff, 0xf8, 0x79, 0x18, byte(number), byte((block - 1) >> 8), byte(block - 1)}
+	if variable {
+		hdr[1] = 0xf9
+	}
+	hdr = append(hdr, crc.Checksum8(hdr))
+	// Independent constant stereo subframes: 100 and -100, explicitly 16-bit.
+	out := append(hdr, 0, 0, 100, 0, 0xff, 0x9c)
+	sum := crc.Checksum16(out)
+	return append(out, byte(sum>>8), byte(sum))
+}
+
+func validationStream(minBlock, maxBlock int, total uint64, frames ...[]byte) []byte {
+	out := buildStreamInfo()
+	binary.BigEndian.PutUint16(out[8:10], uint16(minBlock))
+	binary.BigEndian.PutUint16(out[10:12], uint16(maxBlock))
+	packed := binary.BigEndian.Uint64(out[18:26])
+	binary.BigEndian.PutUint64(out[18:26], packed & ^uint64(0xfffffffff) | total)
+	for _, fr := range frames {
+		out = append(out, fr...)
+	}
+	return out
+}
+
+func validationPCM(samples int) []byte {
+	out := make([]byte, 0, samples*4)
+	for range samples {
+		out = append(out, 100, 0, 0x9c, 0xff)
+	}
+	return out
+}
+
+func TestDecoderDeclaredCountIndependentOfMD5(t *testing.T) {
+	for _, knownMD5 := range []bool{false, true} {
+		for _, total := range []uint64{0, 1, 31, 32, 33, (1 << 36) - 1} {
+			t.Run(fmtValidationName(knownMD5, total), func(t *testing.T) {
+				data := validationStream(16, 16, total, validationFrame(16, 0, false), validationFrame(16, 1, false))
+				if knownMD5 {
+					sum := md5.Sum(validationPCM(32))
+					copy(data[26:42], sum[:])
+				}
+				d, err := NewDecoder(bytes.NewReader(data))
+				if err != nil {
+					t.Fatal(err)
+				}
+				got, err := io.ReadAll(d)
+				switch {
+				case total == 0 || total == 32:
+					if err != nil || !bytes.Equal(got, validationPCM(32)) {
+						t.Fatalf("valid stream: len=%d err=%v", len(got), err)
+					}
+				case total < 32:
+					if !errors.Is(err, flac.ErrUnsupported) {
+						t.Fatalf("count excess: %v", err)
+					}
+				default:
+					if !errors.Is(err, flac.ErrTruncatedStream) {
+						t.Fatalf("count shortfall with MD5=%v: %v", knownMD5, err)
+					}
+				}
+				if err != nil {
+					if n, again := d.Read(make([]byte, 4)); n != 0 || again != err {
+						t.Fatalf("Read failure not sticky: %d %v", n, again)
+					}
+					if n, again := d.WriteTo(io.Discard); n != 0 || again != err {
+						t.Fatalf("WriteTo failure not sticky: %d %v", n, again)
+					}
+				}
+			})
+		}
+	}
+}
+
+func fmtValidationName(md5 bool, total uint64) string {
+	// Decimal names without pulling test-only formatting into fixture generation.
+	prefix := "zero-md5/"
+	if md5 {
+		prefix = "known-md5/"
+	}
+	return prefix + strconv.FormatUint(total, 10)
+}
+
+func TestDecoderFixedFormatRejectsChangedPropertiesBeforeSamples(t *testing.T) {
+	for _, property := range []string{"rate", "channels", "depth"} {
+		t.Run(property, func(t *testing.T) {
+			data := validationStream(16, 16, 16, validationFrame(16, 0, false))
+			packed := binary.BigEndian.Uint64(data[18:26])
+			switch property {
+			case "rate":
+				packed = (packed & ((uint64(1) << 44) - 1)) | uint64(48000)<<44
+			case "channels":
+				packed &= ^(uint64(7) << 41)
+			case "depth":
+				packed = (packed & ^(uint64(31) << 36)) | uint64(23)<<36
+			}
+			binary.BigEndian.PutUint64(data[18:26], packed)
+			d, err := NewDecoder(bytes.NewReader(data))
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := io.ReadAll(d)
+			if len(got) != 0 || !errors.Is(err, flac.ErrUnsupported) {
+				t.Fatalf("changed %s published samples: len=%d err=%v", property, len(got), err)
+			}
+			if cap(d.frame.Channels) != 0 || cap(d.buf) != 0 {
+				t.Fatal("format mismatch grew sample storage")
+			}
+		})
+	}
+}
+
+func TestDecoderFrameSequenceAndBlockBounds(t *testing.T) {
+	cases := []struct {
+		name     string
+		min, max int
+		frames   [][]byte
+	}{
+		{"fixed-gap", 16, 16, [][]byte{validationFrame(16, 0, false), validationFrame(16, 2, false)}},
+		{"fixed-duplicate", 16, 16, [][]byte{validationFrame(16, 0, false), validationFrame(16, 0, false)}},
+		{"first-fixed-number", 16, 16, [][]byte{validationFrame(16, 1, false)}},
+		{"variable-gap", 16, 32, [][]byte{validationFrame(16, 0, true), validationFrame(24, 17, true)}},
+		{"variable-overlap", 16, 32, [][]byte{validationFrame(16, 0, true), validationFrame(24, 15, true)}},
+		{"first-variable-number", 16, 32, [][]byte{validationFrame(16, 1, true)}},
+		{"strategy-change", 16, 16, [][]byte{validationFrame(16, 0, false), validationFrame(16, 16, true)}},
+		{"maximum-block", 16, 16, [][]byte{validationFrame(17, 0, false)}},
+		{"fixed-short-nonfinal", 16, 16, [][]byte{validationFrame(8, 0, false), validationFrame(16, 1, false)}},
+		{"variable-short-nonfinal", 16, 32, [][]byte{validationFrame(8, 0, true), validationFrame(16, 8, true)}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			data := validationStream(tc.min, tc.max, 0, tc.frames...)
+			d, err := NewDecoder(bytes.NewReader(data))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = io.Copy(io.Discard, d); !errors.Is(err, flac.ErrUnsupported) {
+				t.Fatalf("wanted structural failure, got %v", err)
+			}
+		})
+	}
+}
+
+func TestDecoderValidShortTailsAndVariableBlocks(t *testing.T) {
+	for _, tail := range []int{1, 15, 16} {
+		data := validationStream(16, 16, uint64(16+tail), validationFrame(16, 0, false), validationFrame(tail, 1, false))
+		d, err := NewDecoder(bytes.NewReader(data))
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := io.ReadAll(d)
+		if err != nil || !bytes.Equal(got, validationPCM(16+tail)) {
+			t.Fatalf("fixed tail %d: %v", tail, err)
+		}
+	}
+	data := validationStream(16, 32, 41, validationFrame(16, 0, true), validationFrame(24, 16, true), validationFrame(1, 40, true))
+	for _, total := range []uint64{0, 41} {
+		binary.BigEndian.PutUint64(data[18:26], binary.BigEndian.Uint64(data[18:26]) & ^uint64(0xfffffffff) | total)
+		d, err := NewDecoder(bytes.NewReader(data))
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := io.ReadAll(d)
+		if err != nil || !bytes.Equal(got, validationPCM(41)) {
+			t.Fatalf("variable total %d: %v", total, err)
+		}
+		if at, err := d.SeekToSample(20); err != nil || at != 20 {
+			t.Fatalf("variable seek: %d %v", at, err)
+		}
+		got, err = io.ReadAll(d)
+		if err != nil || !bytes.Equal(got, validationPCM(21)) {
+			t.Fatalf("variable seek tail: %v", err)
+		}
+	}
+}
+
+func TestDecoderValidationAfterSeekAndReset(t *testing.T) {
+	data := validationStream(16, 16, 33, validationFrame(16, 0, false), validationFrame(16, 1, false), validationFrame(1, 2, false))
+	d, err := NewDecoder(bytes.NewReader(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if at, err := d.SeekToSample(20); err != nil || at != 20 {
+		t.Fatalf("seek: %d %v", at, err)
+	}
+	got, err := io.ReadAll(d)
+	if err != nil || !bytes.Equal(got, validationPCM(13)) {
+		t.Fatalf("seek tail: %v", err)
+	}
+	bad := validationStream(16, 16, 34, validationFrame(16, 0, false), validationFrame(16, 1, false), validationFrame(1, 2, false))
+	if err := d.Reset(bytes.NewReader(bad)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.SeekToSample(20); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(io.Discard, d); !errors.Is(err, flac.ErrTruncatedStream) {
+		t.Fatalf("seek skipped count validation: %v", err)
+	}
+	if err := d.Reset(bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	got, err = io.ReadAll(d)
+	if err != nil || !bytes.Equal(got, validationPCM(33)) {
+		t.Fatalf("reset did not recover: %v", err)
+	}
+}
+
+func TestDecoderScratchPreflightAndReuse(t *testing.T) {
+	data := validationStream(16, 0, 0, validationFrame(65536, 0, false))
+	opts := DecoderOptions{MaxScratchBytes: decoderScratchBase + 4096}
+	d, err := NewDecoderWithOptions(bytes.NewReader(data), opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(io.Discard, d); !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("scratch preflight: %v", err)
+	}
+	if cap(d.frame.Channels) != 0 || cap(d.buf) != 0 {
+		t.Fatal("oversized frame allocated sample storage")
+	}
+	good := validationStream(16, 16, 16, validationFrame(16, 0, false))
+	if err := d.Reset(bytes.NewReader(good)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(io.Discard, d); err != nil {
+		t.Fatal(err)
+	}
+	if d.scratchBytes() > d.options.MaxScratchBytes {
+		t.Fatal("retained scratch exceeds limit")
+	}
+	if _, err := d.SeekToSample(1); err != nil {
+		t.Fatal(err)
+	}
+	if d.scratchBytes() > d.options.MaxScratchBytes {
+		t.Fatal("seek scratch exceeds limit")
+	}
+}
+
+func TestDecoderSeekRejectsUnsupportedValidFrame(t *testing.T) {
+	data := validationStream(16, 16, 16, validationFrame(16, 0, false))
+	packed := binary.BigEndian.Uint64(data[18:26])
+	binary.BigEndian.PutUint64(data[18:26], (packed&((uint64(1)<<44)-1))|uint64(48000)<<44)
+	d, err := NewDecoder(bytes.NewReader(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.SeekToSample(1); !errors.Is(err, flac.ErrUnsupported) {
+		t.Fatalf("seek discarded unsupported valid frame: %v", err)
+	}
+	if _, err := d.Read(make([]byte, 4)); !errors.Is(err, flac.ErrUnsupported) {
+		t.Fatalf("seek format failure not sticky: %v", err)
+	}
+}
+
+func TestDecoderTinyScratchLimitRejectsBeforeReaderAllocation(t *testing.T) {
+	d := &Decoder{options: DecoderOptions{MaxScratchBytes: 1}}
+	if err := d.Reset(bytes.NewReader(buildStream())); !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("tiny scratch accepted: %v", err)
+	}
+	if d.br != nil || d.md5 != nil {
+		t.Fatal("fixed storage allocated before scratch preflight")
+	}
+}
