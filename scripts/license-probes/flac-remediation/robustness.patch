--- /dev/null
+++ b/internal/frame/residual_limits_test.go
@@ -0,0 +1,108 @@
+package frame
+
+import (
+	"fmt"
+	"testing"
+
+	flac "github.com/tphakala/go-flac"
+	"github.com/tphakala/go-flac/internal/bitio"
+)
+
+func TestResidualValueLimits64(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		value int64
+		valid bool
+	}{
+		{"negative-limit", -(1<<31 - 1), true},
+		{"positive-limit", 1<<31 - 1, true},
+		{"zero", 0, true},
+		{"excluded-int32-min", -1 << 31, false},
+		{"positive-overflow", 1 << 31, false},
+		{"negative-overflow", -(1 << 31) - 1, false},
+		{"side-channel-extreme", 1<<32 - 1, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := validResiduals64([]int64{0, tc.value, 1}); got != tc.valid {
+				t.Fatalf("validResiduals64(%d) = %v, want %v", tc.value, got, tc.valid)
+			}
+		})
+	}
+}
+
+func TestWidePredictorResidualsAreSpecLegal(t *testing.T) {
+	for bps := 25; bps <= 33; bps++ {
+		for level := 0; level <= 8; level++ {
+			t.Run(fmt.Sprintf("bps%d/level%d", bps, level), func(t *testing.T) {
+				s := make([]int64, 4096)
+				for i := range s {
+					switch i % 7 {
+					case 0:
+						s[i] = -(int64(1) << (bps - 1))
+					case 1:
+						s[i] = (int64(1) << (bps - 1)) - 1
+					case 2:
+						s[i] = 0
+					default:
+						s[i] = int64((uint64(i)*1664525+1013904223)&((uint64(1)<<bps)-1)) - (int64(1) << (bps - 1))
+					}
+				}
+				p := paramsLevel(t, level)
+				var ws Workspace
+				plan := planSubframe64(&ws, 0, s, bps, p, apodizationWindow(p, len(s)))
+				if (plan.kind == 2 || plan.kind == 3) && !validResiduals64(ws.cand[0].res64[:len(s)-plan.order]) {
+					t.Fatal("predictor selected out-of-domain residuals")
+				}
+				// This 32-bit PCM fixture requires verbatim fallback. Wider decorrelated
+				// channels may still find legal LPC residuals; those are checked above.
+				if bps == 32 && plan.kind != 1 {
+					t.Fatalf("kind = %d, want verbatim fallback", plan.kind)
+				}
+			})
+		}
+	}
+}
+
+func TestWideFixedOrderUsesValidAlternative(t *testing.T) {
+	// Order 0 includes the excluded int32 minimum. Order 1 has a single legal
+	// residual, so it remains usable instead of rejecting the entire signal.
+	s := []int64{-1 << 31, -(1 << 31) + 1}
+	for _, exhaustive := range []bool{false, true} {
+		var ws Workspace
+		order, _ := chooseFixedOrder64(&ws, s, Params{ExhaustiveFixed: exhaustive})
+		if order != 1 {
+			t.Fatalf("exhaustive %v: fixed order = %d, want 1", exhaustive, order)
+		}
+	}
+}
+
+func TestWideConstantAllowsInt32Minimum(t *testing.T) {
+	var ws Workspace
+	p := paramsLevel(t, 5)
+	s := []int64{-1 << 31, -1 << 31}
+	plan := planSubframe64(&ws, 0, s, 32, p, apodizationWindow(p, len(s)))
+	if plan.kind != 0 {
+		t.Fatalf("constant minimum: kind = %d, want constant", plan.kind)
+	}
+}
+
+func TestWideVerbatimFallbackZeroAllocation(t *testing.T) {
+	const blockSize = 4096
+	input := make([]int32, blockSize)
+	for i := range input {
+		if i%2 == 0 {
+			input[i] = -1 << 31
+		} else {
+			input[i] = 1<<31 - 1
+		}
+	}
+	channels := [][]int32{input}
+	p := paramsLevel(t, 5)
+	si := flac.StreamInfo{SampleRate: 48000, BitDepth: 32, Channels: 1}
+	ws := NewWorkspace(blockSize, 1, 12)
+	writer := bitio.NewWriter()
+	EncodeFrame(writer, ws, p, si, channels, 0)
+	if got := testing.AllocsPerRun(20, func() { EncodeFrame(writer, ws, p, si, channels, 0) }); got != 0 {
+		t.Fatalf("verbatim fallback allocated %.0f times per frame, want 0", got)
+	}
+}
