diff --git a/internal/meta/limits_test.go b/internal/meta/limits_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bb51123473a9f346a5d1759ce04e1d492bdfdfdf
--- /dev/null
+++ b/internal/meta/limits_test.go
@@ -0,0 +1,170 @@
+package meta
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"runtime"
+	"testing"
+
+	flac "github.com/tphakala/go-flac"
+	"github.com/tphakala/go-flac/internal/bitio"
+)
+
+func metadataWithBlock(blockType, declaredLength int, body []byte) []byte {
+	data := buildStreamInfoOnly(4096, 4096, 48000, 2, 16, 0, [16]byte{})
+	data[4] &^= 0x80
+	data = append(data, EncodeBlockHeader(true, blockType, declaredLength)...)
+	return append(data, body...)
+}
+
+func TestMetadataByteLimits(t *testing.T) {
+	valid := buildStreamInfoOnly(4096, 4096, 48000, 2, 16, 0, [16]byte{})
+	withID3 := append([]byte{'I', 'D', '3', 4, 0, 0, 0, 0, 0, 1, 0}, valid...)
+	withPadding := metadataWithBlock(TypePadding, 8, make([]byte, 8))
+	for _, tc := range []struct {
+		name  string
+		data  []byte
+		limit int64
+		want  error
+	}{
+		{"exact stream", valid, int64(len(valid)), nil},
+		{"stream short", valid, int64(len(valid) - 1), flac.ErrResourceLimit},
+		{"all skipped blocks", withPadding, int64(len(withPadding) - 1), flac.ErrResourceLimit},
+		{"id3 counted", withID3, int64(len(withID3) - 1), flac.ErrResourceLimit},
+		{"id3 exact", withID3, int64(len(withID3)), nil},
+		{"negative limit", valid, -1, flac.ErrResourceLimit},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(tc.data)), ReadOptions{MaxBytes: tc.limit})
+			if !errors.Is(err, tc.want) {
+				t.Fatalf("got %v, want %v", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestSeekTableLimitsAndSkip(t *testing.T) {
+	points := []SeekPoint{{SampleNumber: 0, FrameSamples: 4096}, {SampleNumber: 4096, ByteOffset: 10, FrameSamples: 4096}, {SampleNumber: 8192, ByteOffset: 20, FrameSamples: 4096}}
+	body := EncodeSeekPoints(points)
+	data := metadataWithBlock(TypeSeekTable, len(body), body)
+	for _, tc := range []struct {
+		name  string
+		opts  ReadOptions
+		want  error
+		count int
+	}{
+		{"default retains", ReadOptions{}, nil, 3},
+		{"one entry budget", ReadOptions{MaxSeekTableBytes: SeekPointMemoryBytes}, flac.ErrResourceLimit, 0},
+		{"exact entries", ReadOptions{MaxSeekTableBytes: 3 * SeekPointMemoryBytes}, nil, 3},
+		{"skip no retained allocation", ReadOptions{SkipSeekTable: true, MaxSeekTableBytes: 1}, nil, 0},
+		{"skip still counts bytes", ReadOptions{SkipSeekTable: true, MaxBytes: int64(len(data) - 1)}, flac.ErrResourceLimit, 0},
+		{"negative retained limit", ReadOptions{MaxSeekTableBytes: -1}, flac.ErrResourceLimit, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			sm, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), tc.opts)
+			if !errors.Is(err, tc.want) {
+				t.Fatalf("got %v, want %v", err, tc.want)
+			}
+			if len(sm.SeekPoints) != tc.count {
+				t.Fatalf("points %d, want %d", len(sm.SeekPoints), tc.count)
+			}
+			if tc.opts.MaxSeekTableBytes > 0 && int64(cap(sm.SeekPoints))*SeekPointMemoryBytes > tc.opts.MaxSeekTableBytes {
+				t.Fatal("retained capacity exceeds limit")
+			}
+		})
+	}
+}
+
+func TestSeekTableLengthCheckedBeforeBody(t *testing.T) {
+	for _, skip := range []bool{false, true} {
+		data := metadataWithBlock(TypeSeekTable, 19, nil)
+		_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{SkipSeekTable: skip})
+		if !errors.Is(err, flac.ErrUnsupported) {
+			t.Fatalf("skip=%v: got %v, want malformed length", skip, err)
+		}
+	}
+}
+
+func TestTruncatedLargeSeekTableDoesNotAllocateDeclaredBody(t *testing.T) {
+	// The largest divisible-by-18 body fits the on-disk 24-bit length field.
+	// Raising the encoded-byte cap ensures the incremental parser is exercised.
+	data := metadataWithBlock(TypeSeekTable, (0xFFFFFF/SeekPointBytes)*SeekPointBytes, nil)
+	runtime.GC()
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{MaxBytes: 32 << 20})
+	runtime.ReadMemStats(&after)
+	if !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("got %v, want truncated table", err)
+	}
+	if allocated := after.TotalAlloc - before.TotalAlloc; allocated > 128<<10 {
+		t.Fatalf("truncated 46-byte input allocated %d bytes", allocated)
+	}
+}
+
+func TestSkippedSeekTableMustBeComplete(t *testing.T) {
+	data := metadataWithBlock(TypeSeekTable, 18, make([]byte, 17))
+	_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{SkipSeekTable: true})
+	if !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("got %v, want truncated skipped table", err)
+	}
+}
+
+func TestLargeID3RejectedBeforeBody(t *testing.T) {
+	data := []byte{'I', 'D', '3', 4, 0, 0, 0x7f, 0x7f, 0x7f, 0x7f}
+	_, err := ReadMetadata(bitio.NewReader(bytes.NewReader(data)))
+	if !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("got %v, want limit before body", err)
+	}
+}
+
+func TestMetadataLimitAggregatesManyBlocks(t *testing.T) {
+	data := buildStreamInfoOnly(4096, 4096, 48000, 2, 16, 0, [16]byte{})
+	data[4] &^= 0x80
+	for i := range 100 {
+		data = append(data, EncodeBlockHeader(i == 99, TypePadding, 1)...)
+		data = append(data, 0)
+	}
+	_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{MaxBytes: int64(len(data) - 1)})
+	if !errors.Is(err, flac.ErrResourceLimit) {
+		t.Fatalf("got %v, want cumulative limit", err)
+	}
+	if _, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{MaxBytes: int64(len(data))}); err != nil {
+		t.Fatalf("exact cumulative limit: %v", err)
+	}
+}
+
+func TestPlaceholderSeekPointsDoNotConsumeRetainedBudget(t *testing.T) {
+	body := EncodeSeekPoints(placeholders(10))
+	data := metadataWithBlock(TypeSeekTable, len(body), body)
+	sm, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(data)), ReadOptions{MaxSeekTableBytes: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cap(sm.SeekPoints) != 0 {
+		t.Fatalf("placeholder table retained %d points", cap(sm.SeekPoints))
+	}
+}
+
+func TestDuplicateSeekTableRejectedBeforeBody(t *testing.T) {
+	body := EncodeSeekPoints([]SeekPoint{{SampleNumber: 0, FrameSamples: 4096}})
+	data := buildStreamInfoOnly(4096, 4096, 48000, 2, 16, 0, [16]byte{})
+	data[4] &^= 0x80
+	data = append(data, EncodeBlockHeader(false, TypeSeekTable, len(body))...)
+	data = append(data, body...)
+	// A complete second table is forbidden even if the caller skips both.
+	// The truncated variant verifies rejection happens before body reading.
+	for _, complete := range []bool{false, true} {
+		duplicate := append(bytes.Clone(data), EncodeBlockHeader(true, TypeSeekTable, len(body))...)
+		if complete {
+			duplicate = append(duplicate, body...)
+		}
+		for _, skip := range []bool{false, true} {
+			_, err := ReadMetadataWithOptions(bitio.NewReader(bytes.NewReader(duplicate)), ReadOptions{SkipSeekTable: skip})
+			if !errors.Is(err, flac.ErrUnsupported) {
+				t.Fatalf("complete=%v skip=%v: got %v, want duplicate error", complete, skip, err)
+			}
+		}
+	}
+}
diff --git a/internal/meta/meta.go b/internal/meta/meta.go
index 62ed480f7ef2cb3fc99086a77e551bba42e3f2ba..866f42467716960a6d730a945b265575cb62cd8f 100644
--- a/internal/meta/meta.go
+++ b/internal/meta/meta.go
@@ -27,0 +28,14 @@ const (
+// DefaultMaxBytes bounds the metadata section, including any leading ID3 tag.
+// Callers can explicitly raise this limit for unusually large embedded pictures.
+const DefaultMaxBytes int64 = 16 << 20
+
+// ReadOptions sets metadata parser limits. Zero values select bounded defaults.
+// MaxBytes counts the marker, ID3 bytes and every metadata header/body, even
+// metadata that is skipped. MaxSeekTableBytes bounds retained seek-point storage.
+// SkipSeekTable discards valid seek tables without retaining any points.
+type ReadOptions struct {
+	MaxBytes          int64
+	MaxSeekTableBytes int64
+	SkipSeekTable     bool
+}
+
@@ -29 +43,18 @@ func ReadMetadata(br *bitio.Reader) (StreamMeta, error) {
-	sm, err := readMetadata(br)
+	return ReadMetadataWithOptions(br, ReadOptions{})
+}
+
+// ReadMetadataWithOptions reads metadata under caller-supplied limits. Declared
+// lengths are checked before reading bodies; seek points are retained only after
+// a complete entry has been read, so a truncated large table cannot force a
